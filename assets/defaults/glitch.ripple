// Tears the actor into shifted bands with colour splitting.

vec4 effect(vec2 uv) {
    vec2 res = max(_resolution, vec2(1.0));
    float p = _progress;
    float strength = smoothstep(0.0, 0.5, p);
    float frame = floor(p * 30.0);
    float bands = 12.0 + floor(fract(sin(frame * 7.13 + _random * 3.0) * 43758.5) * 16.0);
    float slice = floor(uv.y * bands);
    float r = fract(sin(slice * 127.1 + frame * 311.7 + _random * 17.0) * 43758.5453);
    float hit = step(0.65 - p * 0.45, r);
    float shift = (r - 0.5) * strength * 0.3 * hit;
    vec2 suv = vec2(uv.x + shift, uv.y);
    float split = strength * 0.025 * (0.5 + r);
    vec4 cr = pixel(suv + vec2(split, 0.0));
    vec4 cg = pixel(suv);
    vec4 cb = pixel(suv - vec2(split, 0.0));
    vec4 col = vec4(cr.r, cg.g, cb.b, max(max(cr.a, cg.a), cb.a));
    col.rgb = min(col.rgb, vec3(col.a));
    float inside = step(0.0, suv.x) * step(suv.x, 1.0);
    float scan = 1.0 - 0.25 * strength * step(0.5, fract(uv.y * res.y * 0.5));
    float flick = fract(sin(frame * 91.3 + _random * 11.0) * 43758.5453);
    float flicker = mix(1.0, step(0.3, flick), smoothstep(0.35, 0.7, p));
    float alpha = 1.0 - smoothstep(0.6, 1.0, p);
    return col * inside * scan * flicker * alpha;
}
