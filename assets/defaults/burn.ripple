// Burns the actor away along a glowing, noisy edge.

vec4 effect(vec2 uv) {
    vec2 res = max(_resolution, vec2(1.0));
    float aspect = res.x / res.y;
    vec2 g = uv * vec2(aspect, 1.0) * 4.0 + _random * 53.0;
    vec2 gi = floor(g);
    vec2 gf = fract(g);
    gf = gf * gf * (3.0 - 2.0 * gf);
    float h00 = fract(sin(dot(gi, vec2(127.1, 311.7))) * 43758.5453);
    float h10 = fract(sin(dot(gi + vec2(1.0, 0.0), vec2(127.1, 311.7))) * 43758.5453);
    float h01 = fract(sin(dot(gi + vec2(0.0, 1.0), vec2(127.1, 311.7))) * 43758.5453);
    float h11 = fract(sin(dot(gi + vec2(1.0, 1.0), vec2(127.1, 311.7))) * 43758.5453);
    float nval = mix(mix(h00, h10, gf.x), mix(h01, h11, gf.x), gf.y);
    vec2 g2 = g * 3.1;
    vec2 gi2 = floor(g2);
    vec2 gf2 = fract(g2);
    gf2 = gf2 * gf2 * (3.0 - 2.0 * gf2);
    float k00 = fract(sin(dot(gi2, vec2(269.5, 183.3))) * 43758.5453);
    float k10 = fract(sin(dot(gi2 + vec2(1.0, 0.0), vec2(269.5, 183.3))) * 43758.5453);
    float k01 = fract(sin(dot(gi2 + vec2(0.0, 1.0), vec2(269.5, 183.3))) * 43758.5453);
    float k11 = fract(sin(dot(gi2 + vec2(1.0, 1.0), vec2(269.5, 183.3))) * 43758.5453);
    nval = nval * 0.7 + mix(mix(k00, k10, gf2.x), mix(k01, k11, gf2.x), gf2.y) * 0.3;
    float t = _progress * 1.3 - 0.15;
    float d = nval - t;
    float alpha = smoothstep(0.0, 0.015, d);
    float glow = 1.0 - smoothstep(0.0, 0.12, d);
    vec3 fire = mix(vec3(1.0, 0.9, 0.5), vec3(0.85, 0.2, 0.02), smoothstep(0.0, 0.12, d));
    vec4 col = pixel(uv);
    col.rgb = mix(col.rgb, fire * col.a, glow);
    col.rgb *= 1.0 - 0.6 * glow * smoothstep(0.06, 0.12, d);
    return col * alpha;
}
