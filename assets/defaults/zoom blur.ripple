// Zooms out with a radial blur.
//@padding 30

vec4 effect(vec2 uv) {
    float p = _progress;
    vec2 c = uv - 0.5;
    float scale = 1.0 - p * 0.35;
    float strength = p * 0.2;
    vec4 acc = vec4(0.0);
    for (int i = 0; i < 12; i++) {
        float k = float(i) / 11.0;
        vec2 suv = c * scale * (1.0 - strength * k) + 0.5;
        float ins = step(0.0, suv.x) * step(suv.x, 1.0) * step(0.0, suv.y) * step(suv.y, 1.0);
        acc += pixel(suv) * ins;
    }
    acc /= 12.0;
    return acc * (1.0 - smoothstep(0.3, 1.0, p));
}
